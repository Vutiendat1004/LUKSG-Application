# Sao chép file này thành .env.local (chạy trên máy) hoặc khai báo từng dòng trên Vercel:
# Vercel → Project → Settings → Environment Variables

# Địa chỉ và khoá công khai của Supabase đã có sẵn trong lib/supabase/config.ts, không cần khai báo.
# Khoá service_role: BÍ MẬT, chỉ đặt trên Vercel / máy của bạn, không gửi cho ai
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend → API Keys
RESEND_API_KEY=re_...
# Email gửi đi, phải thuộc tên miền đã xác minh trên Resend
EMAIL_FROM=LUK SG <thongbao@luk.vn>

# Một chuỗi ngẫu nhiên dài (vd tạo ở https://1password.com/password-generator). Dán đúng chuỗi này vào 02_lich_tu_dong.sql
CRON_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai

# Link app sau khi lên Vercel (dùng trong email và mã QR)
NEXT_PUBLIC_APP_URL=https://app.luk.vn
